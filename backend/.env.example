# Copy to .env and fill in real values before running outside of `docker compose up`
# (docker-compose.yml already sets sane local defaults for Postgres).

# --- General ---
PROJECT_NAME=HealthVault AI API
ENVIRONMENT=local
DEBUG=true

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://superuser@localhost:5432/healthvault
DB_ECHO=false

# --- JWT ---
# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File storage ---
# local | azure
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Azure Blob Storage (required if STORAGE_BACKEND=azure) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=medical-records

# --- AI provider: mock | azure | openai ---
AI_PROVIDER=mock

# --- Azure OpenAI (required if AI_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- OpenAI (optional, if AI_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Azure Document Intelligence (optional OCR / extraction) ---
DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=

# --- HIPAA / audit ---
AUDIT_LOG_ENABLED=true
SESSION_IDLE_TIMEOUT_MINUTES=15
